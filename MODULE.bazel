"""pertry is a monorepo of local-first Go applications: bookscape and sicht"""

module(
    name = "pertry",
    repo_name = "com_github_adnoctem_pertry",
)

# Version compatibility, verified against the pinned Bazel in .bazelversion (9.2.0), which is
# the LTS the sibling repositories pin as well:
# rules_go 0.64.1 is the current stable release and the first line that treats Bazel 8/9
# toolchain resolution as the default. gazelle 0.54.0 is the current stable release; its
# 1.0.0-beta/2.0.0-beta tags are deliberately avoided. gazelle declares a floor of
# rules_go 0.59.0, which MVS raises to the 0.64.1 requested here.
bazel_dep(name = "rules_go", version = "0.64.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")

# One toolchain for the whole repo. docs/design/sicht.md section 3 requires >= 1.25 for
# http.CrossOriginProtection; this is pinned to the same patch release as go.mod so the
# Bazel build and a bare `go build` cannot disagree.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_anthropics_anthropic_sdk_go",
    "com_github_expr_lang_expr",
    "com_github_google_go_cmp",
    "com_github_olekukonko_tablewriter",
    "com_github_openai_openai_go_v3",
    "com_github_spf13_cobra",
    "com_github_virtualtam_netscape_go_v2",
    "in_gopkg_yaml_v3",
    "org_golang_x_image",
    "org_golang_x_sync",
    "org_golang_x_sys",
    "org_modernc_sqlite",
)
