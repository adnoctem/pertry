load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "addr",
    srcs = ["addr.go"],
    importpath = "github.com/adnoctem/pertry/internal/formr/addr",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":addr",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "addr_test",
    srcs = ["addr_test.go"],
    deps = [":addr"],
)
