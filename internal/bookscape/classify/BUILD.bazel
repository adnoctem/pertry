load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "classify",
    srcs = [
        "model.go",
        "rules.go",
    ],
    importpath = "github.com/adnoctem/pertry/internal/bookscape/classify",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/bookscape/config",
        "//internal/bookscape/store",
        "//pkg/infer",
    ],
)

alias(
    name = "go_default_library",
    actual = ":classify",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "classify_test",
    srcs = [
        "model_test.go",
        "rules_test.go",
    ],
    deps = [
        ":classify",
        "//internal/bookscape/config",
        "//internal/bookscape/store",
        "//pkg/infer",
        "@com_github_google_go_cmp//cmp",
    ],
)
