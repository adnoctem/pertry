load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dedupe",
    srcs = [
        "normalize.go",
        "plan.go",
    ],
    importpath = "github.com/adnoctem/pertry/internal/bookscape/dedupe",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/bookscape/config",
        "//internal/bookscape/store",
    ],
)

alias(
    name = "go_default_library",
    actual = ":dedupe",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "dedupe_test",
    srcs = [
        "normalize_test.go",
        "plan_test.go",
    ],
    deps = [
        ":dedupe",
        "//internal/bookscape/config",
        "//internal/bookscape/store",
        "@com_github_google_go_cmp//cmp",
    ],
)
