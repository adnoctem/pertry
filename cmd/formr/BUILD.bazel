load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "formr_lib",
    srcs = ["main.go"],
    importpath = "github.com/adnoctem/pertry/cmd/formr",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/formr/cmd",
        "//pkg/stamp",
    ],
)

go_binary(
    name = "formr",
    embed = [":formr_lib"],
    visibility = ["//visibility:public"],
)
