load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ollamabackend",
    srcs = [
        "capabilities.go",
        "ollama.go",
    ],
    importpath = "github.com/adnoctem/pertry/pkg/infer/ollamabackend",
    visibility = ["//visibility:public"],
    deps = ["//pkg/infer"],
